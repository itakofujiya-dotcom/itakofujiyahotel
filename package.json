{
  "name": "itako-fujiya-hotel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check:supabase": "node scripts/check-supabase.mjs",
    "check:rates-data": "node scripts/check-rate-data.mjs",
    "check:booking-search": "node scripts/check-booking-search.mjs",
    "check:public-booking": "node scripts/check-public-booking.mjs",
    "test:auth": "node --experimental-strip-types --test scripts/admin-authorization.test.mjs",
    "test:rooms": "node --experimental-strip-types --test scripts/admin-rooms.test.mjs",
    "test:rates": "node --experimental-strip-types --test scripts/admin-rates.test.mjs",
    "test:rate-rules": "node --experimental-strip-types --test scripts/admin-rates.test.mjs",
    "test:inventory": "node --experimental-strip-types --test scripts/admin-inventory.test.mjs",
    "test:reservations": "node --experimental-strip-types --test scripts/admin-reservations.test.mjs",
    "test:payments": "node --experimental-strip-types --test scripts/admin-payments.test.mjs",
    "test:customers": "node --experimental-strip-types --test scripts/admin-customers.test.mjs",
    "test:dashboard": "node --experimental-strip-types --test scripts/admin-dashboard.test.mjs",
    "test:settings": "node --experimental-strip-types --test scripts/admin-settings.test.mjs",
    "test:admin-i18n": "node --experimental-strip-types --test scripts/admin-i18n.test.mjs",
    "test:public-i18n": "node --experimental-strip-types --test scripts/public-i18n.test.mjs",
    "test:sightseeing": "node --experimental-strip-types --test scripts/sightseeing-page.test.mjs",
    "test:facilities": "node --experimental-strip-types --test scripts/facilities-page.test.mjs",
    "test:access": "node --experimental-strip-types --test scripts/access-page.test.mjs",
    "test:policies": "node --test scripts/public-policies.test.mjs",
    "test:locale-fonts": "node --test scripts/locale-fonts.test.mjs",
    "test:sales": "node --experimental-strip-types --test scripts/admin-sales.test.mjs",
    "test:cancellation": "node --experimental-strip-types --test scripts/public-reservation-cancellation.test.mjs",
    "test:bank-transfer-expiration": "node --experimental-strip-types --test scripts/bank-transfer-auto-cancellation.test.mjs",
    "test:config": "node --experimental-strip-types --test scripts/supabase-config.test.mjs",
    "test:booking-search": "node --experimental-strip-types --test scripts/booking-search.test.mjs",
    "test:booking": "node --experimental-strip-types --test scripts/booking-flow.test.mjs scripts/booking-search.test.mjs",
    "test:notifications": "node --experimental-strip-types --test scripts/reservation-email-notifications.test.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "supabase": "^2.115.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.19.1",
    "vite": "^6.0.5"
  }
}
